# Copy to .env locally. Never commit real credentials.
APP_ENV=development
# Runtime role: NOT an owner, superuser, or BYPASSRLS role.
DATABASE_URL=postgresql+psycopg://adamlife_app:CHANGE_ME@127.0.0.1:5432/adamlife
# Separate owner role, only for migrations. Do not supply this to the API process.
MIGRATION_DATABASE_URL=postgresql+psycopg://adamlife_migrator:CHANGE_ME@127.0.0.1:5432/adamlife
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
DB_CONNECT_TIMEOUT=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Set both via configure-google.cmd after creating a Google Web application client.
# Never use VITE_ variables for server credentials.
# GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
SESSION_LIFETIME_SECONDS=2592000
SESSION_IDLE_SECONDS=2592000
# Production: APP_ENV=production, exact HTTPS origins/hosts, PostgreSQL TLS URL.
# Tests ONLY: a separate empty database whose name ends in _test.
# TEST_DATABASE_URL=postgresql+psycopg://adamlife_test:CHANGE_ME@127.0.0.1:5432/adamlife_test
# Optional additional non-owner runtime-role checks on that same test database.
# TEST_RUNTIME_DATABASE_URL=postgresql+psycopg://adamlife_test_app:CHANGE_ME@127.0.0.1:5432/adamlife_test
